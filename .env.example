# Template for environment variables. Copy this file to .env and edit it:
#   cp .env.example .env
# .env is git-ignored so your real secrets never get committed.

MYSQL_DATABASE=livezilla
MYSQL_USER=livezilla
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Host port the app is published on (http://localhost:${APP_PORT})
APP_PORT=8080
